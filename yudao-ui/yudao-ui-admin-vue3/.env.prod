# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径：生产环境由 nginx 同源反向代理，必须留空（相对路径）
# 注意：该值是打包期变量，改域名必须重新构建前端
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 验证码开关（后端 yudao.captcha.enable 默认 true，前端务必保持一致；
# 显式写入可避免本地 .env.local 的 false 污染生产构建）
VITE_APP_CAPTCHA_ENABLE=true

# 后端 yudao.api-encrypt.enable=false，前端同步关闭，避免后续接口误开加密
VITE_APP_API_ENCRYPT_ENABLE=false

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN='http://mall.yudao.iocoder.cn'

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'