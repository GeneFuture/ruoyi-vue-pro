# 版本号
SHOPRO_VERSION=v2.4.1

# 小程序请求方式：true = 使用微信云托管私有协议 callContainer
# 优点：无需在小程序后台配置服务器域名，也无需 ICP 备案
# 本地开发（process.env.NODE_ENV = development）仍走 SHOPRO_DEV_BASE_URL
SHOPRO_USE_CALL_CONTAINER=true
# 微信云托管环境 ID（云托管控制台 → 环境设置）
SHOPRO_CLOUD_ENV=prod-d9gfotsgj9f75f885
# 微信云托管服务名（服务管理 → 服务列表中的服务名称）
SHOPRO_CLOUD_SERVICE=springboot-csjr

# 后端接口 - 正式环境（callContainer 模式下仅用于文件上传等兜底场景）
SHOPRO_BASE_URL=https://springboot-csjr-344073-6-1528079030.sh.run.tcloudbase.com

# 后端接口 - 体验环境（通过 process.env.NODE_ENV 非 development -体验环境-trial）
SHOPRO_TRIAL_BASE_URL=https://springboot-csjr-344073-6-1528079030.sh.run.tcloudbase.com

# 后端接口 - 测试环境（通过 process.env.NODE_ENV = development）
SHOPRO_DEV_BASE_URL=http://127.0.0.1:48080
### SHOPRO_DEV_BASE_URL=http://10.171.1.188:48080
### SHOPRO_DEV_BASE_URL = http://yunai.natapp1.cc

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
SHOPRO_UPLOAD_TYPE=server

# 后端接口前缀（一般不建议调整）
SHOPRO_API_PATH=/app-api

# 后端 websocket 接口前缀
SHOPRO_WEBSOCKET_PATH=/infra/ws

# 开发环境运行端口
SHOPRO_DEV_PORT=3000

# 客户端静态资源地址 空=默认使用服务端指定的CDN资源地址前缀 | local=本地  |  http(s)://xxx.xxx=自定义静态资源地址前缀
# local = 使用小程序包内 static/ 资源，不依赖模板 CDN
SHOPRO_STATIC_URL=local
### SHOPRO_STATIC_URL = https://file.sheepjs.com

# 前端 H5 访问域名（用于拼团分享文案里的详情链接）
# 未部署 H5 时可以为空；部署后改成真实的 HTTPS 域名
SHOPRO_H5_URL=

# 是否开启直播  1 开启直播 | 0 关闭直播
SHOPRO_MPLIVE_ON=0

# 租户ID 默认 1
SHOPRO_TENANT_ID=1
