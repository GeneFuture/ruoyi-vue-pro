			"^s-(.*)": "@/sheep/components/s-$1/s-$1.vue",
			"^su-(.*)": "@/sheep/ui/su-$1/su-$1.vue"
		}
	},
	"pages": [{
			"path": "pages/maritime/course-list",
			"aliasPath": "/",
			"style": {
				"navigationBarTitleText": "课程列表",
				"enablePullDownRefresh": true
			},
			"meta": {
				"auth": false,
				"sync": true,
				"title": "课程列表",
				"group": "海员培训"
			}
		},
		{
			"path": "pages/maritime/my-enrollments",
